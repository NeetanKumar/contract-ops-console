DATABASE_URL="postgresql://USER@localhost:5432/contract_ops_console?schema=public"
PORT=4000
# Comma-separated list of allowed origins for CORS (frontend dev server / deployed frontend URL)
CORS_ORIGIN="http://localhost:5173"
# PDF attachments are stored in S3 (see src/lib/attachmentStorage.ts). Needs
# AWS credentials available via the default SDK chain (e.g. `aws configure`).
S3_BUCKET_NAME=your-attachments-bucket-name
AWS_REGION=us-east-1
# Used by the WhatsApp deal-extraction AI feature (src/services/dealExtractionService.ts)
ANTHROPIC_API_KEY=your-anthropic-api-key
# WhatsApp Cloud API (src/whatsapp/whatsappCloudApi.ts) — the single shared Meta test
# number used for dev/testing only. Negotiations for this number are created manually
# from the app's WhatsApp setup page (POST /api/whatsapp/negotiations).
WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-access-token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=your-phone-number-id
# From the Meta app's Settings > Basic page (used to verify webhook signatures, and to
# exchange Embedded Signup codes below — it's the same Meta app secret either way)
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any string you choose — enter the same value when registering the webhook URL in
# the Meta dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-verify-token
# Real orgs connect their own WhatsApp Business number via Meta's Embedded Signup flow
# (src/routes/whatsappOnboarding.ts), instead of using the shared test number above.
# Same Meta app as everything else above (see frontend/.env.example for the frontend's
# matching VITE_META_APP_ID / VITE_META_CONFIG_ID).
META_APP_ID=your-meta-app-id
